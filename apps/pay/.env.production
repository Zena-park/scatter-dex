# Production env for the pay Firebase deploy.
#
# .env.local holds each developer's dev values and outranks this file in
# Next's loader order, so firebase-deploy.sh moves it aside before building.
# Everything the browser bundle needs at build time therefore has to be here.
#
# Addresses mirror the on-chain ledger, contracts/deployments/11155111.json —
# keep them in step with it after a redeploy. The backends are the central box
# behind Caddy (deploy/runtime/Caddyfile); they must stay https, because a page
# served over https cannot call http (mixed content), and the CSP in
# firebase.json only allows https/wss.
NEXT_PUBLIC_PAY_CHAIN_ID=11155111
NEXT_PUBLIC_PAY_RPC_URL=https://sepolia.drpc.org
NEXT_PUBLIC_PAY_PRIVATE_SETTLEMENT=0x9aA6CFc593aa76DD76015eB4752A05f3A78EA7a8
NEXT_PUBLIC_PAY_COMMITMENT_POOL=0x1c6bc81704f100C9EddeF79C151F7C2EbEa5848b
NEXT_PUBLIC_PAY_IDENTITY_GATE=0x134ee727b5299e16Ee3fb3aEdf5Ba48D81B7AEa3
NEXT_PUBLIC_PAY_RELAYER_REGISTRY=0x38066496C050e8F45f5454a40d38797ED68dF826
NEXT_PUBLIC_PAY_WETH=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
NEXT_PUBLIC_PAY_DEPLOY_BLOCK=11094792
NEXT_PUBLIC_PAY_RELAYER_URL=https://relayer.zkscatter.tokamon.io
NEXT_PUBLIC_PAY_ZK_X509_URL=https://zk-x509.web.app
NEXT_PUBLIC_SHARED_ORDERBOOK_URL=https://orderbook.zkscatter.tokamon.io
NEXT_PUBLIC_HUB_URL=https://zkscatter-hub.web.app
