# Production env for the admin console Firebase deploy.
#
# .env.local holds each developer's dev values and outranks this file in Next's
# loader order, so firebase-deploy.sh moves it aside before building. Everything
# the browser bundle needs at build time therefore has to be here.
#
# Addresses mirror the on-chain ledger, contracts/deployments/11155111.json —
# keep them in step with it after a redeploy. Backends must stay https: a page
# served over https cannot call http (mixed content), and the CSP in
# firebase.json only allows https/wss.
#
# Nothing here is a secret. The console's authority is gated on-chain by
# `onlyOwner` and off-chain by the SIWE admin allowlist; these values only tell
# it which deployment to read.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.drpc.org
NEXT_PUBLIC_COMMITMENT_POOL_ADDRESS=0x1c6bc81704f100C9EddeF79C151F7C2EbEa5848b
NEXT_PUBLIC_DEPLOY_BLOCK=11094792
NEXT_PUBLIC_PRIVATE_SETTLEMENT_ADDRESS=0x9aA6CFc593aa76DD76015eB4752A05f3A78EA7a8
NEXT_PUBLIC_IDENTITY_GATE_ADDRESS=0x134ee727b5299e16Ee3fb3aEdf5Ba48D81B7AEa3
NEXT_PUBLIC_RELAYER_REGISTRY_ADDRESS=0x38066496C050e8F45f5454a40d38797ED68dF826
NEXT_PUBLIC_FEE_VAULT_ADDRESS=0xC0E66b179753C26b9e2874639142F082c2d33A4e
NEXT_PUBLIC_WETH_ADDRESS=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
NEXT_PUBLIC_ISSUANCE_APPROVAL_REGISTRY_ADDRESS=0x92Da582Bbaf4d2E597A1124834f6aeF8Cc3960a0
NEXT_PUBLIC_SANCTIONS_LIST_ADDRESS=0x54fE07bE88a4B727A5bA8bbD9cC57bf92ea80385
NEXT_PUBLIC_TREASURY_ADDRESS=0x57a344C0BABA24B0716DEFb51F1a3f733795f3aa
NEXT_PUBLIC_SHARED_ORDERBOOK_URL=https://orderbook.zkscatter.tokamon.io
NEXT_PUBLIC_ZK_RELAYER_URL=https://relayer.zkscatter.tokamon.io
NEXT_PUBLIC_ZK_X509_URL=https://zk-x509.web.app
NEXT_PUBLIC_CA_REGISTRATION_URL=https://zk-x509.web.app
NEXT_PUBLIC_HUB_URL=https://zkscatter-hub.web.app
NEXT_PUBLIC_OPERATORS_URL=https://zkscatter-relayer.web.app
